# Include documentation and examples in distributions

include README.md
include LICENSE
include pyproject.toml

# Include all Python and Cython source files
recursive-include obi *.py *.pyx *.pxd *.h

# Include proofs and specifications
recursive-include docs *.md *.pdf *.docx *.txt
recursive-include peer-review *.md *.pdf *.docx

# Include examples
recursive-include examples *.py *.md

# Include tests
recursive-include obi/tests *.py
recursive-include obi/core/tests *.py

# Include transcripts and pseudocode (source of truth design)
recursive-include transcripts *.txt *.md
recursive-include pseudocode *.psc

# Exclude build artifacts
global-exclude *.pyc
global-exclude *.pyo
global-exclude __pycache__
global-exclude *.so
global-exclude *.dll
global-exclude *.dylib
global-exclude *.egg-info
global-exclude .eggs
global-exclude build
global-exclude dist
